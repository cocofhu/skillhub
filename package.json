{
  "name": "skillhub",
  "version": "0.2.1",
  "description": "DeepSeek Harness 插件：在对话中搜索、安装和管理 SkillHub 技能",
  "homepage": "https://github.com/cocofhu/skillhub#readme",
  "bugs": {
    "url": "https://github.com/cocofhu/skillhub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cocofhu/skillhub.git"
  },
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/tests",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/recovery.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skillhub",
    "skills"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.json && mkdir -p lib/tests/fixtures lib/recovery && cp src/client.js lib/client.js && cp src/recovery/overlay.js lib/recovery/overlay.js && cp src/tests/fixtures/* lib/tests/fixtures/",
    "prepare": "npm run build",
    "test": "npm run build && node --test lib/tests/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=lib/api.js --test-coverage-include=lib/categories.js --test-coverage-include=lib/config-store.js --test-coverage-include=lib/http.js --test-coverage-include=lib/install.js --test-coverage-include=lib/plugin-market.js --test-coverage-include=lib/skill-detail.js --test-coverage-include=lib/self-update.js --test-coverage-include=lib/unzip.js --test-coverage-include=lib/recovery/baseline.js --test-coverage-include=lib/recovery/nuke-third-party.js --test-coverage-include=lib/recovery/loopback-auth.js --test-coverage-include=lib/recovery/fail-page-machine.js --test-coverage-include=lib/recovery/host.js --test-coverage-include=lib/recovery/patch-yaml.js --test-coverage-include=lib/recovery/cli.js --test-coverage-lines=95 --test-coverage-functions=85 --test-coverage-branches=70 lib/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:check": "bash .github/scripts/check-pack.sh",
    "recovery": "node lib/recovery/cli.js"
  },
  "bin": {
    "skillhub-recovery": "lib/recovery/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
